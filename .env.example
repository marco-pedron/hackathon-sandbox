# Copy to .env and adjust. Defaults match infra/docker-compose.yml on localhost.
RLN_ALICE_URL=http://localhost:3001
RLN_BOB_URL=http://localhost:3002
RLN_CHARLIE_URL=http://localhost:3003
ESPLORA_URL=http://localhost:3010
SERVER_PORT=8080
# Optional: where QVAC caches models (SDK default: ~/.qvac/models)
# QVAC_CACHE_DIR=

# --- RGB / rgb-lightning-node (Phase 1) ---
# Node passwords (min 8 chars, upstream rule): required by `pnpm rgb:seed` and `pnpm rgb:e2e`. Regtest only.
RLN_ALICE_PASSWORD=
RLN_BOB_PASSWORD=
RLN_CHARLIE_PASSWORD=
# Optional. Empty → the node generates one at /init and rgb:seed writes it back here.
RLN_ALICE_MNEMONIC=
RLN_BOB_MNEMONIC=
RLN_CHARLIE_MNEMONIC=
# Service addresses as seen by the RLN nodes, i.e. inside the Docker network.
RLN_INDEXER_URL=electrs:50001
RLN_BITCOIND_RPC_HOST=bitcoind
RLN_BITCOIND_RPC_PORT=18443
RLN_BITCOIND_RPC_USER=user
RLN_BITCOIND_RPC_PASSWORD=password
RGB_PROXY_ENDPOINT=rpc://proxy:3000/json-rpc
# Demo NIA asset (precision 2: 100 units = 1.00 USD)
DEMO_ASSET_TICKER=DUSD
DEMO_ASSET_NAME="Demo Digital Dollar"
# Mine a regtest block right after each settlement send
RGB_AUTO_MINE=true
