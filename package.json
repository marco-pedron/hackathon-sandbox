{
  "name": "settleup-trip",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "rgb:gen": "pnpm --filter @settleup/rgb-client gen",
    "ai:download": "pnpm --filter @settleup/server ai:download",
    "ai:smoke": "pnpm --filter @settleup/server ai:smoke",
    "rgb:seed": "pnpm --filter @settleup/server rgb:seed",
    "rgb:e2e": "pnpm --filter @settleup/server rgb:e2e",
    "infra:up": "./infra/scripts/up.sh",
    "infra:down": "./infra/scripts/down.sh",
    "infra:reset": "./infra/scripts/reset.sh",
    "infra:check": "./infra/scripts/check.sh",
    "stack:ps": "docker compose -f infra/docker-compose.yml ps",
    "stack:logs": "docker compose -f infra/docker-compose.yml logs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
